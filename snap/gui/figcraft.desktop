[Desktop Entry]
Type=Application
Name=FigCraft
GenericName=Interface Design Tool
Comment=Design and prototype user interfaces
Exec=figcraft %U
Icon=${SNAP}/meta/gui/figcraft.png
Terminal=false
StartupNotify=true
StartupWMClass=figcraft
Categories=Graphics;2DGraphics;VectorGraphics;X-Design;
Keywords=design;interface;ui;ux;prototype;wireframe;mockup;vector;layout;components;
MimeType=application/x-figcraft;image/svg+xml;image/png;image/jpeg;x-scheme-handler/figcraft;
